<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration "installer" (slug: installer). The release workflow
  uploads a GitHub artifact holding only WindowsDebloaterSetup.exe, built after the
  program and scripts inside it were signed with the "payload" configuration. The
  installer copies itself next to the program as Uninstall.exe, so this signs the
  uninstaller too.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="WindowsDebloaterSetup.exe" product-name="Windows Debloater">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
