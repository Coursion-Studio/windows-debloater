<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Debloater Setup" Width="496" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Foreground="#F5F3F2"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">

  <!--
    The setup window. It wears the look of the tool it installs: warm ink, one coral
    accent, a flat card drawn with hairlines. The layout is the one PounceSetup has, so
    Coursion's Windows installers look like a family. The styles are the same ones
    src\ui\MainWindow.xaml uses, with the dark palette written in.

    The window itself is see-through; the panel in it draws the rounded shape and its
    shadow, which is what the margin around it is for.
  -->

  <Window.Resources>
    <SolidColorBrush x:Key="Text" Color="#F5F3F2"/>
    <SolidColorBrush x:Key="Text2" Color="#B8B3B0"/>
    <SolidColorBrush x:Key="Text3" Color="#94FFFFFF"/>
    <SolidColorBrush x:Key="Text4" Color="#6BFFFFFF"/>
    <SolidColorBrush x:Key="Accent" Color="#FF7A59"/>
    <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentText" Color="#FFB199"/>
    <SolidColorBrush x:Key="Line" Color="#61FF7A59"/>
    <SolidColorBrush x:Key="Edge" Color="#24FFFFFF"/>
    <SolidColorBrush x:Key="RuleFill" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="CardFill" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="ChipFill" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="Chip2" Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#2EFFFFFF"/>
    <SolidColorBrush x:Key="SuccessFg" Color="#2ECC71"/>
    <SolidColorBrush x:Key="SuccessBg" Color="#292ECC71"/>
    <SolidColorBrush x:Key="SuccessLine" Color="#732ECC71"/>
    <SolidColorBrush x:Key="DangerFg" Color="#F26B5C"/>
    <SolidColorBrush x:Key="DangerBg" Color="#26E74C3C"/>
    <SolidColorBrush x:Key="DangerLine" Color="#66E74C3C"/>
    <LinearGradientBrush x:Key="AccentFill" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#FF8A66" Offset="0"/>
      <GradientStop Color="#F2643F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DangerFill" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#EC5F4E" Offset="0"/>
      <GradientStop Color="#CF3F2E" Offset="1"/>
    </LinearGradientBrush>

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource ScrollThumb}" CornerRadius="3" Margin="3,2,3,2"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Icon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Heading" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
      <Setter Property="FontSize" Value="23"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,16,0,0"/>
    </Style>

    <Style x:Key="Say" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="19"/>
      <Setter Property="Margin" Value="0,10,0,0"/>
    </Style>

    <Style x:Key="FocusRing">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Rectangle Margin="-3" RadiusX="11" RadiusY="11" Stroke="{DynamicResource Accent}" StrokeThickness="2" SnapsToDevicePixels="True"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardFill}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RuleFill}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <!-- The button that does the thing. Uninstall wears the same shape in red. -->
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
      <Setter Property="Background" Value="{DynamicResource AccentFill}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,8,16,9"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Lift" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
              </Grid.RenderTransform>
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.13"/>
                    <VisualTransition To="Pressed" GeneratedDuration="0:0:0.05"/>
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Normal"/>
                  <VisualState x:Name="MouseOver">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Lift" To="0.97" Duration="0"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                      <DoubleAnimation Storyboard.TargetName="Lift" To="0.97" Duration="0"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Disabled">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Opacity" To="0.36" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"/>
              <Border x:Name="Hover" CornerRadius="8" Background="White" Opacity="0"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="Background" Value="{DynamicResource DangerFill}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource DangerLine}"/>
    </Style>

    <!-- Text only, until the pointer is on it. -->
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,8,14,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Lift" Background="Transparent">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.13"/>
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Normal"/>
                  <VisualState x:Name="MouseOver">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Disabled">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Border CornerRadius="8" Background="{TemplateBinding Background}"/>
              <Border x:Name="Hover" CornerRadius="8" Background="{DynamicResource ChipFill}" Opacity="0"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The close button of the title bar: a small rounded box that turns red. -->
    <Style x:Key="CloseButton" TargetType="Button">
      <Setter Property="Width" Value="30"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.13"/>
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Normal"/>
                  <VisualState x:Name="MouseOver">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.7" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Disabled">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="Opacity" To="0.3" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Border x:Name="Hover" CornerRadius="8" Background="{DynamicResource DangerBg}" Opacity="0"/>
              <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource DangerFg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The Coursion switch: 38 by 22, the knob slides with a little spring. Its label is
         on the left and takes the room there is. -->
    <Style x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="15,13"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CheckStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.22">
                      <VisualTransition.GeneratedEasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                      </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Unchecked"/>
                  <VisualState x:Name="Indeterminate"/>
                  <VisualState x:Name="Checked">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Knob" To="16" Duration="0"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"/>
                      <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.13"/>
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Normal"/>
                  <VisualState x:Name="MouseOver">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="TrackHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="TrackHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Disabled"/>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <DockPanel>
                <Grid DockPanel.Dock="Right" Width="38" Height="22" VerticalAlignment="Center" Margin="14,0,0,0">
                  <Border CornerRadius="11" Background="{DynamicResource ChipFill}" BorderBrush="{DynamicResource Edge}" BorderThickness="1"/>
                  <Border x:Name="TrackHover" CornerRadius="11" Background="{DynamicResource Chip2}" Opacity="0"/>
                  <Border x:Name="TrackOn" CornerRadius="11" Background="{DynamicResource AccentFill}" BorderBrush="{DynamicResource Line}"
                          BorderThickness="1" Opacity="0"/>
                  <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                    <Ellipse.RenderTransform>
                      <TranslateTransform X="0"/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Effect>
                      <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.35"/>
                    </Ellipse.Effect>
                  </Ellipse>
                </Grid>
                <ContentPresenter VerticalAlignment="Center"/>
              </DockPanel>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RowTitle" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="RowSub" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>
  </Window.Resources>

  <Border x:Name="Panel" Margin="28,20,28,36" CornerRadius="12" BorderBrush="{DynamicResource Edge}" BorderThickness="1">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#18151A" Offset="0"/>
        <GradientStop Color="#0E0C10" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <Border.Effect>
      <DropShadowEffect Color="#000000" BlurRadius="34" ShadowDepth="12" Direction="270" Opacity="0.5"/>
    </Border.Effect>
    <Border.RenderTransform>
      <TranslateTransform x:Name="PanelSlide" Y="0"/>
    </Border.RenderTransform>
    <Grid>
      <!-- The one faint light, in the top left corner as in the tool. -->
      <Border CornerRadius="11" IsHitTestVisible="False">
        <Border.Background>
          <RadialGradientBrush MappingMode="Absolute" Center="18,-20" GradientOrigin="18,-20" RadiusX="330" RadiusY="330">
            <GradientStop Color="#2BFF7A59" Offset="0"/>
            <GradientStop Color="#00FF7A59" Offset="1"/>
          </RadialGradientBrush>
        </Border.Background>
      </Border>

      <DockPanel>
        <!-- Title bar. Dragging it moves the window. -->
        <Grid x:Name="Bar" DockPanel.Dock="Top" Height="44" Background="Transparent">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
            <Image x:Name="BarIcon" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock x:Name="BarTitle" Margin="9,0,0,1" FontSize="12.5" Foreground="{DynamicResource Text2}" VerticalAlignment="Center"/>
          </StackPanel>
          <Button x:Name="BtnClose" Style="{StaticResource CloseButton}" HorizontalAlignment="Right" Margin="0,0,8,0">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="10"/>
          </Button>
        </Grid>

        <Grid x:Name="Pages" Margin="26,4,26,24">

          <!-- Before: install, update or uninstall, with what there is to choose. -->
          <StackPanel x:Name="PageStart" Visibility="Collapsed">
            <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
            <Image x:Name="StartHero" Width="84" Height="84" Margin="0,8,0,0" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
              <Image.Effect>
                <DropShadowEffect Color="#FF7A59" BlurRadius="34" ShadowDepth="8" Direction="270" Opacity="0.34"/>
              </Image.Effect>
            </Image>
            <TextBlock x:Name="StartHeading" Style="{StaticResource Heading}"/>
            <TextBlock x:Name="StartVersion" Margin="0,4,0,0" FontSize="12.5" Foreground="{DynamicResource Text3}" TextAlignment="Center"/>
            <TextBlock x:Name="StartSay" Style="{StaticResource Say}"/>
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
              <StackPanel>
                <ToggleButton x:Name="OptFirst" Style="{StaticResource Switch}">
                  <StackPanel>
                    <TextBlock x:Name="OptFirstTitle" Style="{StaticResource RowTitle}"/>
                    <TextBlock x:Name="OptFirstSub" Style="{StaticResource RowSub}" Visibility="Collapsed"/>
                  </StackPanel>
                </ToggleButton>
                <StackPanel x:Name="OptSecondRow">
                  <Border Height="1" Background="{DynamicResource RuleFill}"/>
                  <ToggleButton x:Name="OptSecond" Style="{StaticResource Switch}">
                    <StackPanel>
                      <TextBlock x:Name="OptSecondTitle" Style="{StaticResource RowTitle}"/>
                      <TextBlock x:Name="OptSecondSub" Style="{StaticResource RowSub}"/>
                    </StackPanel>
                  </ToggleButton>
                </StackPanel>
              </StackPanel>
            </Border>
            <StackPanel x:Name="StartFine" Orientation="Horizontal" Margin="4,14,0,0">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" FontSize="12" Foreground="{DynamicResource Text4}" Margin="0,1,8,0"/>
              <TextBlock x:Name="StartFineText" FontSize="11.5" Foreground="{DynamicResource Text4}"/>
            </StackPanel>
            <TextBlock x:Name="StartAgree" FontSize="11.5" Foreground="{DynamicResource Text4}" TextWrapping="Wrap" Margin="4,6,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
              <Button x:Name="BtnCancel" Style="{StaticResource GhostButton}"/>
              <Button x:Name="BtnGo" Style="{StaticResource PrimaryButton}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="BtnGoGlyph" Style="{StaticResource Icon}" Text="&#xE896;" FontSize="13" Margin="0,1,8,0"/>
                  <TextBlock x:Name="BtnGoText"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>

          <!-- The licence, opened from the line that says installing means agreeing to it. -->
          <StackPanel x:Name="PageLicence" Visibility="Collapsed">
            <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
            <TextBlock x:Name="LicenceHeading" Style="{StaticResource Heading}" FontSize="19" TextAlignment="Left" Margin="0,4,0,0"/>
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16,12,6,12">
              <ScrollViewer x:Name="LicenceScroll" Height="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="LicenceBody" Margin="0,0,12,0"/>
              </ScrollViewer>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
              <Button x:Name="BtnLicenceBack" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
          </StackPanel>

          <!-- While it works. -->
          <StackPanel x:Name="PageWork" Visibility="Collapsed">
            <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
            <Image x:Name="WorkHero" Width="64" Height="64" Margin="0,10,0,0" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
              <Image.Effect>
                <DropShadowEffect Color="#FF7A59" BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.3"/>
              </Image.Effect>
            </Image>
            <TextBlock x:Name="WorkHeading" Style="{StaticResource Heading}"/>
            <TextBlock x:Name="WorkStatus" Margin="0,6,0,0" FontSize="12.5" Foreground="{DynamicResource Text3}" TextAlignment="Center"/>
            <Border x:Name="WorkTrack" Height="4" CornerRadius="2" Background="{DynamicResource ChipFill}" Margin="0,24,0,10">
              <Border x:Name="WorkFill" Height="4" CornerRadius="2" HorizontalAlignment="Left" Width="0">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#F2643F" Offset="0"/>
                    <GradientStop Color="#FF8A66" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
              </Border>
            </Border>
          </StackPanel>

          <!-- After it worked. -->
          <StackPanel x:Name="PageDone" Visibility="Collapsed">
            <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
            <Grid x:Name="DoneMedal" Width="68" Height="68" Margin="0,14,0,0" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Grid.RenderTransform>
              <Ellipse Fill="{DynamicResource SuccessBg}" Stroke="{DynamicResource SuccessLine}" StrokeThickness="2">
                <Ellipse.Effect>
                  <DropShadowEffect Color="#2ECC71" BlurRadius="34" ShadowDepth="0" Opacity="0.22"/>
                </Ellipse.Effect>
              </Ellipse>
              <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="27" Foreground="{DynamicResource SuccessFg}"/>
            </Grid>
            <TextBlock x:Name="DoneHeading" Style="{StaticResource Heading}"/>
            <TextBlock x:Name="DoneSay" Style="{StaticResource Say}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
              <Button x:Name="BtnDoneClose" Style="{StaticResource GhostButton}"/>
              <Button x:Name="BtnDoneOpen" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
          </StackPanel>

          <!-- After it did not. -->
          <StackPanel x:Name="PageFail" Visibility="Collapsed">
            <StackPanel.RenderTransform><TranslateTransform/></StackPanel.RenderTransform>
            <Grid Width="68" Height="68" Margin="0,14,0,0" HorizontalAlignment="Center">
              <Ellipse Fill="{DynamicResource DangerBg}" Stroke="{DynamicResource DangerLine}" StrokeThickness="2"/>
              <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" FontSize="27" Foreground="{DynamicResource DangerFg}"/>
            </Grid>
            <TextBlock x:Name="FailHeading" Style="{StaticResource Heading}"/>
            <TextBlock x:Name="FailDetail" Style="{StaticResource Say}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
              <Button x:Name="BtnFailClose" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </DockPanel>
    </Grid>
  </Border>
</Window>
