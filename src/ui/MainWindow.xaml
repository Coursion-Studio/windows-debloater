<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Debloater" Width="1140" Height="780" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#0E0C10"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

  <!--
    The look follows the Coursion house style, the one Pounce for Windows has: a warm
    near-black base with one faint light in the
    corner, flat cards drawn with hairlines, and a single accent that is kept for what can
    be acted on and what is selected. Areas are told apart by their icons and names, never
    by a colour of their own. Every colour is a resource set from Debloater.UI.ps1, so the
    dark and the light theme share this one layout.
  -->

  <WindowChrome.WindowChrome>
    <!-- The sliver of glass at the bottom is never seen. It is what makes Windows give
         the window its shadow and, on Windows 11, its rounded corners. -->
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                  CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>

    <!-- ============================================================ Text -->

    <Style x:Key="Icon" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Small monospaced capitals above a group. -->
    <Style x:Key="Caps" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
      <Setter Property="FontSize" Value="26"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
    </Style>

    <Style x:Key="PageIntro" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <Style x:Key="FocusRing">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Rectangle Margin="-3" RadiusX="11" RadiusY="11" Stroke="{DynamicResource Accent}"
                       StrokeThickness="2" SnapsToDevicePixels="True"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="RoundFocusRing">
      <Setter Property="Control.Template">
        <Setter.Value>
          <ControlTemplate>
            <Ellipse Margin="-6" Stroke="{DynamicResource Text}" StrokeThickness="2"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A small label in a box: counts, "Recommended", "Done". -->
    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="Padding" Value="8,2,8,3"/>
      <Setter Property="Background" Value="{DynamicResource ChipFill}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RuleFill}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- The flat card: a faint fill and a hairline. -->
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardFill}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource RuleFill}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <!-- The line between two rows of a card. -->
    <Style x:Key="Rule" TargetType="Border">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Background" Value="{DynamicResource RuleFill}"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- ============================================================ Scrollbar -->

    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/>
      <Setter Property="MinWidth" Value="10"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource ScrollThumb}" CornerRadius="3" Margin="3,2,3,2"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
            <ControlTemplate.Triggers>
              <!-- Nothing to scroll: keep the space so rows line up, but draw no thumb. -->
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="PART_Track" Property="Visibility" Value="Hidden"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============================================================ The Debloat button -->

    <!--
      A plain disc in the accent, lit from above. Nothing on its face moves. Around it,
      a band of light travels slowly along the rim and a soft light behind it swells and
      settles, as if it were breathing. Tag is set to "lively" from code unless movement
      is switched off, and the movement only runs while the button is on screen: started
      on load, while the button still sits in a hidden view, it would find none of its
      parts and stop the whole window from drawing.
    -->
    <Style x:Key="GoButton" TargetType="Button">
      <Setter Property="Width" Value="112"/>
      <Setter Property="Height" Value="112"/>
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource RoundFocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Lift" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
              </Grid.RenderTransform>
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.22">
                      <VisualTransition.GeneratedEasingFunction>
                        <QuinticEase EasingMode="EaseOut"/>
                      </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                    <VisualTransition To="Pressed" GeneratedDuration="0:0:0.07"/>
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Normal"/>
                  <VisualState x:Name="MouseOver">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Lift" To="1.05" Duration="0"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                      <DoubleAnimation Storyboard.TargetName="Lift" To="1.05" Duration="0"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                      <DoubleAnimation Storyboard.TargetName="Shine" Storyboard.TargetProperty="Opacity" To="0.1" Duration="0"/>
                      <DoubleAnimation Storyboard.TargetName="Cast" Storyboard.TargetProperty="Opacity" To="0.75" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Lift" To="0.96" Duration="0"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                      <DoubleAnimation Storyboard.TargetName="Lift" To="0.96" Duration="0"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                      <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Disabled">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Opacity" To="0.32" Duration="0"/>
                      <DoubleAnimation Storyboard.TargetName="Around" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>

              <Grid x:Name="Breath" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                  <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Grid.RenderTransform>

                <!-- Everything that glows or travels around the disc. -->
                <Grid x:Name="Around">
                  <Ellipse x:Name="Aura" Margin="-30" Fill="{DynamicResource AuraBrush}" Opacity="0.3" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                      <ScaleTransform ScaleX="1" ScaleY="1"/>
                    </Ellipse.RenderTransform>
                  </Ellipse>
                  <!-- The band of light: an arc that is faint at its tail and bright at its
                       head, drawn twice, once blurred for the glow and once sharp. It is
                       drawn on a canvas so that both arcs keep the centre they were given;
                       a grid would centre each by its own size and the light would wobble. -->
                  <Canvas x:Name="Rim" Margin="-6" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                    <Canvas.RenderTransform>
                      <RotateTransform Angle="0"/>
                    </Canvas.RenderTransform>
                    <Path Data="M 62,3.5 A 58.5,58.5 0 0 1 91.25,112.66" Stroke="{DynamicResource RimBrush}" StrokeThickness="8"
                          StrokeEndLineCap="Round" Opacity="0.8">
                      <Path.Effect>
                        <BlurEffect Radius="9"/>
                      </Path.Effect>
                    </Path>
                    <Path Data="M 62,3.5 A 58.5,58.5 0 0 1 91.25,112.66" Stroke="{DynamicResource RimBrush}" StrokeThickness="3"
                          StrokeEndLineCap="Round"/>
                  </Canvas>
                </Grid>

                <!-- The light the disc throws on what is below it. -->
                <Ellipse x:Name="Cast" Margin="12,26,12,-12" Fill="{DynamicResource Accent}" Opacity="0.5">
                  <Ellipse.Effect>
                    <BlurEffect Radius="20"/>
                  </Ellipse.Effect>
                </Ellipse>
                <Ellipse Fill="{DynamicResource AccentFill}"/>
                <Ellipse>
                  <Ellipse.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="#00000000" Offset="0.5"/>
                      <GradientStop Color="#2A000000" Offset="1"/>
                    </LinearGradientBrush>
                  </Ellipse.Fill>
                </Ellipse>
                <Ellipse x:Name="Press" Fill="Black" Opacity="0"/>
                <Ellipse StrokeThickness="1">
                  <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                      <GradientStop Color="#66FFFFFF" Offset="0"/>
                      <GradientStop Color="#00FFFFFF" Offset="0.4"/>
                    </LinearGradientBrush>
                  </Ellipse.Stroke>
                </Ellipse>
                <Ellipse Margin="-1" Stroke="{DynamicResource Line}" StrokeThickness="1"/>
                <Ellipse x:Name="Shine" Fill="White" Opacity="0"/>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
              </Grid>
            </Grid>
            <ControlTemplate.Triggers>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsVisible" Value="True"/>
                  <Condition Property="Tag" Value="lively"/>
                </MultiTrigger.Conditions>
                <!-- Standing still, the band would look like a piece missing from a ring,
                     so it is only there while it travels. -->
                <Setter TargetName="Rim" Property="Visibility" Value="Visible"/>
                <MultiTrigger.EnterActions>
                  <BeginStoryboard x:Name="Breathe">
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                      <DoubleAnimation Storyboard.TargetName="Breath" From="1" To="1.03" Duration="0:0:2.4"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                        <DoubleAnimation.EasingFunction>
                          <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="Breath" From="1" To="1.03" Duration="0:0:2.4"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                        <DoubleAnimation.EasingFunction>
                          <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="Aura" From="0.84" To="1.16" Duration="0:0:2.4"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                        <DoubleAnimation.EasingFunction>
                          <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="Aura" From="0.84" To="1.16" Duration="0:0:2.4"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                        <DoubleAnimation.EasingFunction>
                          <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="Aura" Storyboard.TargetProperty="Opacity" From="0.2" To="0.62" Duration="0:0:2.4">
                        <DoubleAnimation.EasingFunction>
                          <SineEase EasingMode="EaseInOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                  <BeginStoryboard x:Name="Travel">
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetName="Rim" From="0" To="360" Duration="0:0:4.8"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"/>
                    </Storyboard>
                  </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                  <StopStoryboard BeginStoryboardName="Breathe"/>
                  <StopStoryboard BeginStoryboardName="Travel"/>
                </MultiTrigger.ExitActions>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============================================================ Other buttons -->

    <!-- Filled with the accent, dark text: the confirming action. -->
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="16,8,16,9"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Lift" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
              </Grid.RenderTransform>
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.13"/>
                    <VisualTransition To="Pressed" GeneratedDuration="0:0:0.05"/>
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Normal"/>
                  <VisualState x:Name="MouseOver">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.14" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Lift" To="0.97" Duration="0"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                      <DoubleAnimation Storyboard.TargetName="Lift" To="0.97" Duration="0"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Disabled">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Opacity" To="0.36" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Border CornerRadius="8" Background="{DynamicResource AccentFill}" BorderBrush="{DynamicResource Line}" BorderThickness="1"/>
              <Border x:Name="Hover" CornerRadius="8" Background="White" Opacity="0"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PrimaryLargeButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Padding" Value="30,12,30,13"/>
    </Style>

    <!-- A quiet box with a hairline: the other choice next to a primary button. -->
    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,8,14,9"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Lift" RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
              </Grid.RenderTransform>
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.13"/>
                    <VisualTransition To="Pressed" GeneratedDuration="0:0:0.05"/>
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Normal"/>
                  <VisualState x:Name="MouseOver">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                      <DoubleAnimation Storyboard.TargetName="Lift" To="0.97" Duration="0"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                      <DoubleAnimation Storyboard.TargetName="Lift" To="0.97" Duration="0"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Disabled">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Border CornerRadius="8" Background="{DynamicResource ChipFill}" BorderBrush="{DynamicResource Edge}" BorderThickness="1"/>
              <Border x:Name="Hover" CornerRadius="8" Background="{DynamicResource Chip2}" Opacity="0"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SmallSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Padding" Value="12,5,12,6"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <!-- A small box that opens an app in the Store. -->
    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Padding" Value="10,4,10,5"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
    </Style>

    <!-- Text only, until the pointer is on it. -->
    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="11,6,11,7"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Lift" Background="Transparent">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.13"/>
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Normal"/>
                  <VisualState x:Name="MouseOver">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Disabled">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Border CornerRadius="8" Background="{TemplateBinding Background}"/>
              <Border x:Name="Hover" CornerRadius="8" Background="{DynamicResource ChipFill}" Opacity="0"/>
              <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Padding" Value="8,5,8,6"/>
      <Setter Property="Margin" Value="-8,0,0,0"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- History and Settings in the top bar. Tag "on" marks the one whose page is open. -->
    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Margin" Value="2,0,0,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Style.Triggers>
        <Trigger Property="Tag" Value="on">
          <Setter Property="Foreground" Value="{DynamicResource Text}"/>
          <Setter Property="Background" Value="{DynamicResource ChipFill}"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <DataTemplate x:Key="ToolTemplate">
      <StackPanel Orientation="Horizontal">
        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13" Margin="0,1,7,0"/>
        <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
      </StackPanel>
    </DataTemplate>

    <!-- The pill that appears in the top bar when a newer version is out: the accent as
         a wash, a small lit dot and the version. It is the only thing up there that is
         coloured, and it is only there when there is something to do. -->
    <Style x:Key="UpdatePill" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="Padding" Value="11,0,12,1"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Lift">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.13"/>
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Normal"/>
                  <VisualState x:Name="MouseOver">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.5" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Disabled">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Border CornerRadius="13" Background="{DynamicResource Wash}" BorderBrush="{DynamicResource Line}" BorderThickness="1"/>
              <Border x:Name="Hover" CornerRadius="13" Background="{DynamicResource Wash}" Opacity="0"/>
              <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,1,7,0">
                  <Ellipse.Effect>
                    <DropShadowEffect Color="#FF7A59" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                  </Ellipse.Effect>
                </Ellipse>
                <ContentPresenter VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.13"/>
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Normal"/>
                  <VisualState x:Name="MouseOver">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Disabled"/>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Border x:Name="Hover" Background="{DynamicResource Chip2}" Opacity="0"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.13"/>
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Normal"/>
                  <VisualState x:Name="MouseOver">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.75" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Disabled"/>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Border x:Name="Hover" Background="#E81123" Opacity="0"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The Coursion switch: 38 by 22, the knob slides with a little spring. Its label is
         on the left and takes the room there is. -->
    <Style x:Key="Switch" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource Text2}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <DockPanel Background="Transparent">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CheckStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.22">
                      <VisualTransition.GeneratedEasingFunction>
                        <BackEase EasingMode="EaseOut" Amplitude="0.3"/>
                      </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Unchecked"/>
                  <VisualState x:Name="Indeterminate"/>
                  <VisualState x:Name="Checked">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Knob" To="16" Duration="0"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"/>
                      <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.13"/>
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Normal"/>
                  <VisualState x:Name="MouseOver">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="TrackHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="TrackHover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Disabled"/>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Grid DockPanel.Dock="Right" Width="38" Height="22" VerticalAlignment="Center" Margin="14,0,0,0">
                <Border CornerRadius="11" Background="{DynamicResource ChipFill}" BorderBrush="{DynamicResource Edge}" BorderThickness="1"/>
                <Border x:Name="TrackHover" CornerRadius="11" Background="{DynamicResource Chip2}" Opacity="0"/>
                <Border x:Name="TrackOn" CornerRadius="11" Background="{DynamicResource AccentFill}" BorderBrush="{DynamicResource Line}"
                        BorderThickness="1" Opacity="0"/>
                <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0">
                  <Ellipse.RenderTransform>
                    <TranslateTransform X="0"/>
                  </Ellipse.RenderTransform>
                  <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270" Opacity="0.35"/>
                  </Ellipse.Effect>
                </Ellipse>
              </Grid>
              <!-- A long label, in another language for one, goes onto a second line. -->
              <ContentPresenter VerticalAlignment="Center">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap"/>
                  </Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </DockPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ============================================================ Icons and marks -->

    <!-- A page's icon: its picture from ui\icons, or a plain box with a glyph when there
         is none. Drawn at 70 by 70 and scaled by whatever Viewbox holds it. HighQuality
         matters: the picture is far larger than it is shown, and the default way of
         shrinking it skips pixels, which leaves the edges jagged. -->
    <DataTemplate x:Key="IconTemplate">
      <Grid Width="70" Height="70">
        <Border x:Name="Drawn" CornerRadius="18" Background="{DynamicResource ChipFill}" BorderBrush="{DynamicResource RuleFill}" BorderThickness="1">
          <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="28" Foreground="{DynamicResource Text2}"/>
        </Border>
        <Image x:Name="Picture" Source="{Binding Icon}" Stretch="Uniform" Visibility="Collapsed"
               RenderOptions.BitmapScalingMode="HighQuality">
          <Image.Effect>
            <DropShadowEffect BlurRadius="9" ShadowDepth="5" Direction="270" Opacity="0.32" Color="#000000"/>
          </Image.Effect>
        </Image>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HasIcon}" Value="True">
          <Setter TargetName="Drawn" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="Picture" Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The app's mark: four app tiles, three solid and one only an outline, as if it
         had just been taken out. Drawn at 20 by 20 inside whatever holds it. -->
    <DataTemplate x:Key="MarkTemplate">
      <Viewbox>
        <Canvas Width="20" Height="20">
          <Rectangle Canvas.Left="1" Canvas.Top="1" Width="7.6" Height="7.6" RadiusX="2.2" RadiusY="2.2" Fill="White"/>
          <Rectangle Canvas.Left="1" Canvas.Top="11.4" Width="7.6" Height="7.6" RadiusX="2.2" RadiusY="2.2" Fill="White"/>
          <Rectangle Canvas.Left="11.4" Canvas.Top="11.4" Width="7.6" Height="7.6" RadiusX="2.2" RadiusY="2.2" Fill="White"/>
          <Rectangle Canvas.Left="12.1" Canvas.Top="1.7" Width="6.2" Height="6.2" RadiusX="1.8" RadiusY="1.8" Stroke="#C8FFFFFF" StrokeThickness="1.4"/>
        </Canvas>
      </Viewbox>
    </DataTemplate>

    <!-- A tick in a green ring. It swells into place and draws its stroke whenever it
         comes into view. Drawn at 70 by 70. -->
    <DataTemplate x:Key="TickBadge">
      <Grid x:Name="Orb" Width="70" Height="70" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
          <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>
        <Ellipse Fill="{DynamicResource SuccessBg}" Stroke="{DynamicResource SuccessLine}" StrokeThickness="2.5"/>
        <Path x:Name="OrbTick" Data="M 22,36 L 31,45 L 49,26" Stroke="{DynamicResource SuccessFg}" StrokeThickness="5.5" StrokeStartLineCap="Round"
              StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeDashCap="Round" StrokeDashArray="9 9" StrokeDashOffset="0"/>
      </Grid>
      <DataTemplate.Triggers>
        <Trigger SourceName="Orb" Property="IsVisible" Value="True">
          <Trigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Orb" From="0.6" To="1" Duration="0:0:0.4"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                  <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Orb" From="0.6" To="1" Duration="0:0:0.4"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                  <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="OrbTick" Storyboard.TargetProperty="StrokeDashOffset" From="9.4" To="0" Duration="0:0:0.44">
                  <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut"/>
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
        </Trigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The amber mark for an area where something went wrong. -->
    <DataTemplate x:Key="WarnBadge">
      <Grid Width="70" Height="70">
        <Ellipse Fill="{DynamicResource CautionBg}" Stroke="{DynamicResource CautionLine}" StrokeThickness="2.5"/>
        <Path Data="M 35,20 L 35,39" Stroke="{DynamicResource CautionFg}" StrokeThickness="5.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        <Ellipse Width="6.5" Height="6.5" Fill="{DynamicResource CautionFg}" VerticalAlignment="Top" Margin="0,46,0,0"/>
      </Grid>
    </DataTemplate>

    <!-- ============================================================ Debloating -->

    <!-- One line of the list under the lanes that says what has just been done. -->
    <DataTemplate x:Key="FeedTemplate">
      <StackPanel Orientation="Horizontal" Height="28" Opacity="{Binding Strength}">
        <TextBlock x:Name="FeedMark" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="11" Foreground="{DynamicResource SuccessFg}" Margin="2,1,11,0"/>
        <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource Text2}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding Area}" FontSize="11.5" Foreground="{DynamicResource Text4}" VerticalAlignment="Center" Margin="12,1,0,0"/>
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="failed">
          <Setter TargetName="FeedMark" Property="Text" Value="&#xE711;"/>
          <Setter TargetName="FeedMark" Property="Foreground" Value="{DynamicResource DangerFg}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="skipped">
          <Setter TargetName="FeedMark" Property="Text" Value="&#xE738;"/>
          <Setter TargetName="FeedMark" Property="Foreground" Value="{DynamicResource Text3}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One area while it is being debloated: a flat card like any other. The one being
         worked on comes forward, takes a wash of the accent and an accent hairline; a
         finished one gets its tick in the corner. -->
    <DataTemplate x:Key="LaneTemplate">
      <Grid x:Name="Lane" Margin="0,0,12,0" Opacity="0.6" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
          <TranslateTransform Y="0"/>
        </Grid.RenderTransform>
        <Border Style="{StaticResource Card}"/>
        <Border x:Name="LaneOn" CornerRadius="12" Background="{DynamicResource Wash}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Opacity="0"/>
        <Grid Margin="17,16,17,15">
          <Viewbox x:Name="LaneDone" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource TickBadge}"/>
          </Viewbox>
          <Viewbox x:Name="LaneWarn" Width="24" Height="24" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource WarnBadge}"/>
          </Viewbox>
          <DockPanel LastChildFill="False">
            <Viewbox DockPanel.Dock="Top" Width="66" Height="66" HorizontalAlignment="Left" Margin="-4,-2,0,0">
              <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource IconTemplate}"/>
            </Viewbox>
            <TextBlock DockPanel.Dock="Top" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                       TextWrapping="Wrap" Margin="0,12,0,0"/>
            <TextBlock x:Name="LaneStatus" DockPanel.Dock="Bottom" Text="{Binding Status}" FontSize="11.5" Foreground="{DynamicResource Text3}"
                       TextTrimming="CharacterEllipsis" Margin="0,8,0,0" Height="17"/>
            <ProgressBar x:Name="LaneBar" DockPanel.Dock="Bottom" Style="{DynamicResource Meter}" Value="0" Margin="0,10,0,0"/>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal">
              <TextBlock x:Name="LaneCount" Text="{Binding CountText}" FontSize="30" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                         FontFamily="Segoe UI Variable Display, Segoe UI" RenderTransformOrigin="0,0.85">
                <TextBlock.RenderTransform>
                  <ScaleTransform ScaleX="1" ScaleY="1"/>
                </TextBlock.RenderTransform>
              </TextBlock>
              <TextBlock Text="{Binding TotalText}" FontSize="12" Foreground="{DynamicResource Text3}" VerticalAlignment="Bottom" Margin="7,0,0,6"/>
            </StackPanel>
          </DockPanel>
        </Grid>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsActive}" Value="True">
          <Setter TargetName="LaneStatus" Property="Foreground" Value="{DynamicResource AccentText}"/>
          <DataTrigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Lane" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"/>
                <DoubleAnimation Storyboard.TargetName="LaneOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"/>
                <DoubleAnimation Storyboard.TargetName="Lane" Duration="0:0:0.3" To="-6"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                  <DoubleAnimation.EasingFunction>
                    <QuinticEase EasingMode="EaseOut"/>
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Lane" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.3"/>
                <DoubleAnimation Storyboard.TargetName="LaneOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                <DoubleAnimation Storyboard.TargetName="Lane" Duration="0:0:0.3" To="0"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"/>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.ExitActions>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsDone}" Value="True">
          <Setter TargetName="LaneDone" Property="Visibility" Value="Visible"/>
          <Setter TargetName="LaneBar" Property="Foreground" Value="{DynamicResource SuccessFg}"/>
          <DataTrigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Lane" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" BeginTime="0:0:0.05"/>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
        </DataTrigger>
        <DataTrigger Binding="{Binding HasProblem}" Value="True">
          <Setter TargetName="LaneDone" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="LaneWarn" Property="Visibility" Value="Visible"/>
          <Setter TargetName="LaneBar" Property="Foreground" Value="{DynamicResource CautionFg}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ============================================================ Overview -->

    <!-- One area on the overview: a row of the list, and a button that opens the area.
         Under the pointer a quiet box appears behind it and the arrow moves a step. -->
    <Style x:Key="AreaRow" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Lift" Background="Transparent">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.18">
                      <VisualTransition.GeneratedEasingFunction>
                        <QuinticEase EasingMode="EaseOut"/>
                      </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                    <VisualTransition To="Pressed" GeneratedDuration="0:0:0.06"/>
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Normal"/>
                  <VisualState x:Name="MouseOver">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                      <DoubleAnimation Storyboard.TargetName="Arrow" To="4" Duration="0"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"/>
                      <DoubleAnimation Storyboard.TargetName="Arrow" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                      <DoubleAnimation Storyboard.TargetName="IconBox" To="1.08" Duration="0"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                      <DoubleAnimation Storyboard.TargetName="IconBox" To="1.08" Duration="0"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0"/>
                      <DoubleAnimation Storyboard.TargetName="Arrow" To="4" Duration="0"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Disabled"/>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Border x:Name="Hover" Margin="5" CornerRadius="9" Background="{DynamicResource ChipFill}" Opacity="0"/>
              <Grid Margin="18,15,18,15">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Viewbox x:Name="IconBox" Width="52" Height="52" Margin="0,0,16,0" RenderTransformOrigin="0.5,0.5">
                  <Viewbox.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                  </Viewbox.RenderTransform>
                  <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource IconTemplate}"/>
                </Viewbox>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                  <TextBlock Text="{Binding Summary}" FontSize="11.5" Foreground="{DynamicResource Text3}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Border x:Name="CountChip" Grid.Column="2" Style="{StaticResource Chip}" Margin="12,0,0,0">
                  <TextBlock x:Name="CountText" Text="{Binding Chip}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="{DynamicResource Text2}"/>
                </Border>
                <TextBlock x:Name="Arrow" Grid.Column="3" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10" Foreground="{DynamicResource Text3}"
                           Margin="14,1,0,0" Opacity="0.6">
                  <TextBlock.RenderTransform>
                    <TranslateTransform X="0"/>
                  </TextBlock.RenderTransform>
                </TextBlock>
              </Grid>
            </Grid>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding ChipKind}" Value="done">
                <Setter TargetName="CountChip" Property="Background" Value="{DynamicResource SuccessBg}"/>
                <Setter TargetName="CountChip" Property="BorderBrush" Value="{DynamicResource SuccessLine}"/>
                <Setter TargetName="CountText" Property="Foreground" Value="{DynamicResource SuccessFg}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding ChipKind}" Value="quiet">
                <Setter TargetName="CountText" Property="Foreground" Value="{DynamicResource Text3}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Chip}" Value="">
                <Setter TargetName="CountChip" Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The line above a row is left out for the first row of a card. -->
    <DataTemplate x:Key="AreaRowTemplate">
      <Grid>
        <Button Style="{StaticResource AreaRow}" AutomationProperties.Name="{Binding Title}"/>
        <Border x:Name="Sep" Style="{StaticResource Rule}"/>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
          <Setter TargetName="Sep" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ============================================================ Area rows -->

    <!-- A whole row that ticks when clicked anywhere. The box fills with the accent and
         the tick draws itself in. The row itself stays plain: with twenty ticked rows, a
         tint on each would be louder than what it says. -->
    <Style x:Key="ItemRow" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid x:Name="Lift" Background="Transparent">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.13"/>
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Normal"/>
                  <VisualState x:Name="MouseOver">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Disabled"/>
                </VisualStateGroup>
                <VisualStateGroup x:Name="CheckStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.2">
                      <VisualTransition.GeneratedEasingFunction>
                        <QuinticEase EasingMode="EaseOut"/>
                      </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Unchecked"/>
                  <VisualState x:Name="Indeterminate"/>
                  <VisualState x:Name="Checked">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Box" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                      <DoubleAnimation Storyboard.TargetName="BoxFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                      <DoubleAnimation Storyboard.TargetName="BoxFill" To="1" Duration="0"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                      <DoubleAnimation Storyboard.TargetName="BoxFill" To="1" Duration="0"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                      <DoubleAnimation Storyboard.TargetName="Tick" Storyboard.TargetProperty="StrokeDashOffset" To="0" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Border x:Name="Hover" Margin="5" CornerRadius="9" Background="{DynamicResource ChipFill}" Opacity="0"/>
              <Grid Margin="17,13,17,13">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Width="20" Height="20" VerticalAlignment="Top" Margin="0,1,14,0">
                  <Border x:Name="Box" CornerRadius="6" BorderThickness="1.5" BorderBrush="{DynamicResource BoxBorder}" Background="Transparent"/>
                  <Border x:Name="BoxFill" CornerRadius="6" Background="{DynamicResource AccentFill}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                      <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
                    </Border.RenderTransform>
                  </Border>
                  <!-- One long dash, pushed off the end of the line until the row is ticked. -->
                  <Path x:Name="Tick" Data="M 5,10.4 L 8.6,13.8 L 15,6.6" Stroke="{DynamicResource OnAccent}" StrokeThickness="2.1"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                        StrokeDashCap="Round" StrokeDashArray="9 9" StrokeDashOffset="9.6"/>
                </Grid>
                <ContentPresenter Grid.Column="1"/>
              </Grid>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DetailsToggle" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource Text3}"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Grid Background="Transparent">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.13"/>
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Normal"/>
                  <VisualState x:Name="MouseOver">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Disabled"/>
                </VisualStateGroup>
                <!-- The little arrow turns to point down when the details are open. -->
                <VisualStateGroup x:Name="CheckStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.18">
                      <VisualTransition.GeneratedEasingFunction>
                        <QuinticEase EasingMode="EaseOut"/>
                      </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Unchecked"/>
                  <VisualState x:Name="Indeterminate"/>
                  <VisualState x:Name="Checked">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Arrow" To="90" Duration="0"
                                       Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"/>
                    </Storyboard>
                  </VisualState>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Border x:Name="Hover" CornerRadius="6" Background="{DynamicResource Chip2}" Opacity="0"/>
              <StackPanel Orientation="Horizontal" Margin="7,2,8,3">
                <TextBlock x:Name="Arrow" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="8" Margin="0,1,6,0"
                           RenderTransformOrigin="0.5,0.5">
                  <TextBlock.RenderTransform>
                    <RotateTransform Angle="0"/>
                  </TextBlock.RenderTransform>
                </TextBlock>
                <ContentPresenter VerticalAlignment="Center"/>
              </StackPanel>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="ItemTemplate">
      <Grid>
        <CheckBox Style="{StaticResource ItemRow}" IsChecked="{Binding IsSelected, Mode=TwoWay}" AutomationProperties.Name="{Binding Title}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Description}" Foreground="{DynamicResource Text2}" FontSize="12" TextWrapping="Wrap"
                         Margin="0,2,0,0" Visibility="{Binding HasDescription, Converter={StaticResource BoolVis}}"/>
              <StackPanel Orientation="Horizontal" Margin="-7,5,0,-3">
                <ToggleButton Style="{StaticResource DetailsToggle}" IsChecked="{Binding IsExpanded, Mode=TwoWay}" Content="{Binding DetailsLabel}"/>
              </StackPanel>
              <Border x:Name="DetailsPanel" CornerRadius="8" Background="{DynamicResource Well}" BorderBrush="{DynamicResource RuleFill}" BorderThickness="1"
                      Padding="12,9,12,10" Margin="0,8,0,2" Visibility="{Binding IsExpanded, Converter={StaticResource BoolVis}}">
                <Border.RenderTransform>
                  <TranslateTransform Y="0"/>
                </Border.RenderTransform>
                <TextBlock Text="{Binding Details}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" TextWrapping="Wrap"
                           Foreground="{DynamicResource Text2}" LineHeight="18"/>
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="14,0,0,0">
              <Border Style="{StaticResource Chip}" Margin="6,0,0,0" Visibility="{Binding Recommended, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding RecommendedText}" FontSize="11" Foreground="{DynamicResource Text2}"/>
              </Border>
              <Border Style="{StaticResource Chip}" Background="{DynamicResource CautionBg}" BorderBrush="{DynamicResource CautionLine}" Margin="6,0,0,0"
                      Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="10" Foreground="{DynamicResource CautionFg}" Margin="0,1,5,0"/>
                  <TextBlock Text="{Binding AdminText}" FontSize="11" Foreground="{DynamicResource CautionFg}"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </CheckBox>
        <Border x:Name="Sep" Style="{StaticResource Rule}"/>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
          <Setter TargetName="Sep" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
          <DataTrigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="DetailsPanel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                <DoubleAnimation Storyboard.TargetName="DetailsPanel" From="-6" To="0" Duration="0:0:0.24"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)">
                  <DoubleAnimation.EasingFunction>
                    <QuinticEase EasingMode="EaseOut"/>
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="DoneItemTemplate">
      <Grid>
        <DockPanel Margin="18,11,17,12" Opacity="0.82">
          <Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{DynamicResource SuccessBg}" BorderBrush="{DynamicResource SuccessLine}" Margin="12,0,0,0">
            <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="{DynamicResource SuccessFg}"/>
          </Border>
          <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12"
                     Foreground="{DynamicResource SuccessFg}" Margin="3,0,18,0"/>
          <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Text2}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
        <Border x:Name="Sep" Style="{StaticResource Rule}"/>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
          <Setter TargetName="Sep" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A group of an area: its label, then one card with a row for each item. -->
    <DataTemplate x:Key="GroupTemplate">
      <StackPanel Margin="0,0,0,6">
        <StackPanel Orientation="Horizontal" Margin="4,14,0,9">
          <TextBlock Style="{StaticResource Caps}" Text="{Binding Title}" VerticalAlignment="Center"/>
          <TextBlock Style="{StaticResource Caps}" Text="{Binding CountText}" Margin="10,0,0,0" Foreground="{DynamicResource Text4}" VerticalAlignment="Center"/>
        </StackPanel>
        <Border Style="{StaticResource Card}">
          <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource ItemTemplate}" Focusable="False"/>
        </Border>
      </StackPanel>
    </DataTemplate>

    <!-- ============================================================ Other rows -->

    <!-- One line of the confirmation sheet. -->
    <DataTemplate x:Key="SummaryTemplate">
      <Grid>
        <DockPanel Margin="14,10,14,11">
          <Viewbox DockPanel.Dock="Left" Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Center">
            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource IconTemplate}"/>
          </Viewbox>
          <!-- What happens, and under it a line about how, where there is one. -->
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding Text}" Foreground="{DynamicResource Text}" TextWrapping="Wrap"/>
            <TextBlock x:Name="NoteLine" Text="{Binding Note}" FontSize="11.5" Foreground="{DynamicResource Text3}" TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
        </DockPanel>
        <Border x:Name="Sep" Style="{StaticResource Rule}"/>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
          <Setter TargetName="Sep" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Note}" Value="">
          <Setter TargetName="NoteLine" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
          <Setter TargetName="NoteLine" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="NoteTemplate">
      <Border x:Name="Bar" CornerRadius="8" Padding="13,9,13,10" Margin="0,0,0,6" Background="{DynamicResource ChipFill}"
              BorderBrush="{DynamicResource RuleFill}" BorderThickness="1">
        <DockPanel>
          <TextBlock x:Name="Ico" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13"
                     Foreground="{DynamicResource Text2}" Margin="0,2,11,0" VerticalAlignment="Top"/>
          <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="{DynamicResource Text}" FontSize="12.5"/>
        </DockPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="warning">
          <Setter TargetName="Bar" Property="Background" Value="{DynamicResource CautionBg}"/>
          <Setter TargetName="Bar" Property="BorderBrush" Value="{DynamicResource CautionLine}"/>
          <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource CautionFg}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="success">
          <Setter TargetName="Bar" Property="Background" Value="{DynamicResource SuccessBg}"/>
          <Setter TargetName="Bar" Property="BorderBrush" Value="{DynamicResource SuccessLine}"/>
          <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource SuccessFg}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One step in the full list behind Details. -->
    <DataTemplate x:Key="StepTemplate">
      <Grid>
        <Grid Margin="18,10,15,11">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="Ico" Style="{StaticResource Icon}" Text="&#xEA3A;" FontSize="13" Foreground="{DynamicResource Text4}"
                     Margin="2,0,16,0" RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
              <RotateTransform Angle="0"/>
            </TextBlock.RenderTransform>
          </TextBlock>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Text}" FontSize="13" TextWrapping="Wrap"/>
            <TextBlock x:Name="Msg" Text="{Binding Message}" Foreground="{DynamicResource Text3}" FontSize="11.5"
                       TextWrapping="Wrap" Margin="0,2,0,0"/>
          </StackPanel>
          <Border x:Name="Pill" Grid.Column="2" Style="{StaticResource Chip}" Margin="12,0,0,0">
            <TextBlock x:Name="PillText" Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource Text2}"/>
          </Border>
        </Grid>
        <Border x:Name="Sep" Style="{StaticResource Rule}"/>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
          <Setter TargetName="Sep" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Message}" Value="">
          <Setter TargetName="Msg" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="running">
          <Setter TargetName="Ico" Property="Text" Value="&#xE895;"/>
          <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource AccentText}"/>
          <DataTrigger.EnterActions>
            <BeginStoryboard x:Name="Spin">
              <Storyboard RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="Ico"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                 From="0" To="360" Duration="0:0:1.1"/>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <StopStoryboard BeginStoryboardName="Spin"/>
          </DataTrigger.ExitActions>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="ok">
          <Setter TargetName="Ico" Property="Text" Value="&#xE73E;"/>
          <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource SuccessFg}"/>
          <Setter TargetName="Pill" Property="Background" Value="{DynamicResource SuccessBg}"/>
          <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource SuccessLine}"/>
          <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource SuccessFg}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="failed">
          <Setter TargetName="Ico" Property="Text" Value="&#xE711;"/>
          <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource DangerFg}"/>
          <Setter TargetName="Pill" Property="Background" Value="{DynamicResource DangerBg}"/>
          <Setter TargetName="Pill" Property="BorderBrush" Value="{DynamicResource DangerLine}"/>
          <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource DangerFg}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="skipped">
          <Setter TargetName="Ico" Property="Text" Value="&#xE738;"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="StatTemplate">
      <Border Style="{StaticResource Card}" Padding="16,12,16,13" Margin="0,0,10,0">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="Dot" Width="7" Height="7" Fill="{DynamicResource SuccessFg}" VerticalAlignment="Center" Margin="0,1,8,0"/>
            <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Text3}" FontSize="11.5"/>
          </StackPanel>
          <TextBlock Text="{Binding Value}" Foreground="{DynamicResource Text}" FontSize="26" FontWeight="SemiBold"
                     FontFamily="Segoe UI Variable Display, Segoe UI" Margin="0,3,0,0"/>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="failed">
          <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource DangerFg}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="skipped">
          <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Text4}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A row to choose with, on the Settings page. -->
    <Style x:Key="ChoiceRow" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding" Value="17,12,17,13"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Lift" Background="Transparent">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.13"/>
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Normal"/>
                  <VisualState x:Name="MouseOver">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0"/>
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Disabled"/>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <Border x:Name="Hover" Margin="5" CornerRadius="9" Background="{DynamicResource ChipFill}" Opacity="0"/>
              <ContentPresenter Margin="{TemplateBinding Padding}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="ChoiceTemplate">
      <Grid>
        <Button Style="{StaticResource ChoiceRow}" AutomationProperties.Name="{Binding Title}">
          <DockPanel>
            <Grid DockPanel.Dock="Right" Width="18" Height="18" Margin="12,0,0,0">
              <Ellipse x:Name="Ring" Stroke="{DynamicResource BoxBorder}" StrokeThickness="1.5"/>
              <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{DynamicResource Accent}" Visibility="Collapsed"
                       RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                  <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
            <TextBlock Text="{Binding Title}" Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
          </DockPanel>
        </Button>
        <Border x:Name="Sep" Style="{StaticResource Rule}"/>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
          <Setter TargetName="Sep" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsChosen}" Value="True">
          <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}"/>
          <DataTrigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Dot" From="0.2" To="1" Duration="0:0:0.28"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                  <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="Dot" From="0.2" To="1" Duration="0:0:0.28"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                  <DoubleAnimation.EasingFunction>
                    <BackEase EasingMode="EaseOut" Amplitude="0.6"/>
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One earlier run on the History page. -->
    <DataTemplate x:Key="RunTemplate">
      <Border Style="{StaticResource Card}" Padding="18,14,12,15" Margin="0,0,0,10">
        <StackPanel>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
              <Button Style="{StaticResource SmallSecondaryButton}" Tag="undo" Content="{Binding UndoText}"
                      Visibility="{Binding CanUndo, Converter={StaticResource BoolVis}}"/>
              <Button Style="{StaticResource GhostButton}" Tag="open" Content="{Binding OpenText}" FontSize="12"/>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Title}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Foreground="{DynamicResource Text}"/>
              <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{DynamicResource Text3}" Margin="0,4,0,0"
                         TextWrapping="Wrap" Visibility="{Binding HasSubtitle, Converter={StaticResource BoolVis}}"/>
            </StackPanel>
          </DockPanel>
          <StackPanel Margin="0,12,0,-6" Visibility="{Binding HasApps, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding AppsLabel}" FontSize="11.5" Foreground="{DynamicResource Text3}" Margin="0,0,0,8" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding Apps}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource ChipButton}" Tag="store" Content="{Binding Name}" ToolTip="{Binding Tip}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <Style x:Key="SearchBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Text}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" CornerRadius="8" Background="{DynamicResource ChipFill}" BorderBrush="{DynamicResource Edge}"
                    BorderThickness="1" Padding="11,0,10,0" Height="32">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="12" Foreground="{DynamicResource Text3}" Margin="0,1,9,0"/>
                <TextBlock x:Name="Hint" Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Text3}"
                           VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" Margin="2,0,0,1"/>
                <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Line}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- A thin bar that fills with the accent: how far a lane, or the whole run, has got. -->
    <Style x:Key="Meter" TargetType="ProgressBar">
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="Height" Value="3"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid>
              <Border x:Name="PART_Track" CornerRadius="2" Background="{DynamicResource Chip2}"/>
              <Border x:Name="PART_Indicator" CornerRadius="2" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Window.Resources>

  <!-- ================================================================ Layout -->

  <Grid x:Name="Root" Background="{DynamicResource BaseFill}">

    <!-- The one light in the room: a faint wash of the accent from the top left corner. -->
    <Border Background="{DynamicResource CornerLight}" IsHitTestVisible="False"/>

    <!-- Title bar buttons -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="20">
      <Button x:Name="BtnMin" Style="{StaticResource CaptionButton}">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE921;" FontSize="10"/>
      </Button>
      <Button x:Name="BtnMax" Style="{StaticResource CaptionButton}">
        <TextBlock x:Name="MaxGlyph" Style="{StaticResource Icon}" Text="&#xE922;" FontSize="10"/>
      </Button>
      <Button x:Name="BtnClose" Style="{StaticResource CloseCaptionButton}">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="10"/>
      </Button>
    </StackPanel>

    <!-- Top bar: the app's mark and name on the left, History and Settings on the right. It
         lies in the title bar, so the window can be dragged by the space in between. On a
         very wide screen the top bar and the pages keep to one centred column of the same
         width, so lines of text and rows do not run on for ever. -->
    <Grid MaxWidth="1480" VerticalAlignment="Top">
      <DockPanel x:Name="TopBar" VerticalAlignment="Top" Height="34" Margin="34,8,150,0" LastChildFill="False">
        <Border DockPanel.Dock="Left" Width="22" Height="22" CornerRadius="7" Background="{DynamicResource Brand}" VerticalAlignment="Center">
          <ContentPresenter Content="" ContentTemplate="{StaticResource MarkTemplate}" Margin="4.5"/>
        </Border>
        <TextBlock x:Name="BrandName" DockPanel.Dock="Left" Text="Windows Debloater" FontSize="13"
                   Foreground="{DynamicResource Text2}" VerticalAlignment="Center" Margin="10,0,0,1"/>
        <!-- "Dry run" or "Demo", when the window was started that way. -->
        <Border x:Name="ModeRow" DockPanel.Dock="Left" Style="{StaticResource Chip}" Margin="11,1,0,0" Padding="7,1,7,2" Visibility="Collapsed">
          <TextBlock x:Name="ModeTag" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" Foreground="{DynamicResource Text2}"/>
        </Border>
        <Button x:Name="BtnSettings" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" ContentTemplate="{StaticResource ToolTemplate}"/>
        <Button x:Name="BtnHistory" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" ContentTemplate="{StaticResource ToolTemplate}"/>
        <!-- Only there when a newer version is out. -->
        <Button x:Name="BtnUpdate" DockPanel.Dock="Right" Style="{StaticResource UpdatePill}" Visibility="Collapsed"/>
      </DockPanel>
    </Grid>

    <!-- Pages, below the top bar -->
    <Grid Margin="0,46,0,0" MaxWidth="1480">

      <!-- Loading -->
      <StackPanel x:Name="ViewLoading" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,46">
        <!-- The app's mark, with a ring that spreads out from it while the PC is looked at. -->
        <Grid Width="120" Height="120" HorizontalAlignment="Center">
          <Border x:Name="LoadingHalo" Width="60" Height="60" CornerRadius="18" BorderBrush="{DynamicResource Accent}" BorderThickness="1.5"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
              <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
          </Border>
          <Border Width="60" Height="60" CornerRadius="18" Background="{DynamicResource Brand}">
            <ContentPresenter Content="" ContentTemplate="{StaticResource MarkTemplate}" Margin="13"/>
          </Border>
        </Grid>
        <TextBlock x:Name="LoadingText" Foreground="{DynamicResource Text2}" FontSize="13.5" HorizontalAlignment="Center" Margin="0,6,0,0"/>
      </StackPanel>

      <!-- Overview: a heading, then two cards side by side under a label each. The list of
           areas is on the left; what is ready and the one Debloat button are on the right.
           Both cards sit in the same row of the grid, so they start and end on the same
           lines. The rows of the list share the height there is; in a very tall window
           the cards stop growing. -->
      <Grid x:Name="ViewHome" Visibility="Collapsed" Margin="34,6,34,30">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*" MaxHeight="655"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="22"/>
          <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>

        <!-- What there is to do. -->
        <DockPanel x:Name="HomeHead" Grid.ColumnSpan="3" Margin="0,6,0,0">
          <Border DockPanel.Dock="Left" Width="60" Height="60" CornerRadius="17" Background="{DynamicResource Brand}" VerticalAlignment="Center">
            <ContentPresenter Content="" ContentTemplate="{StaticResource MarkTemplate}" Margin="13"/>
          </Border>
          <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="HomeTitle" Style="{StaticResource PageTitle}"/>
            <TextBlock x:Name="HomeSub" Style="{StaticResource PageIntro}"/>
          </StackPanel>
        </DockPanel>
        <!-- The same place once everything recommended has been applied: when, and how much. -->
        <DockPanel x:Name="HomeBanner" Grid.ColumnSpan="3" Margin="0,6,0,0" Visibility="Collapsed">
          <Border DockPanel.Dock="Left" Width="60" Height="60" CornerRadius="17" Background="{DynamicResource Brand}" VerticalAlignment="Center">
            <ContentPresenter Content="" ContentTemplate="{StaticResource MarkTemplate}" Margin="13"/>
          </Border>
          <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="HomeBannerTitle" Style="{StaticResource PageTitle}"/>
            <TextBlock x:Name="HomeBannerSub" Style="{StaticResource PageIntro}"/>
          </StackPanel>
        </DockPanel>

        <!-- The label of each card. -->
        <TextBlock x:Name="HomeEyebrow" Grid.Row="1" Style="{StaticResource Caps}" Margin="4,26,0,10"/>
        <TextBlock x:Name="HomePanelLabel" Grid.Row="1" Grid.Column="2" Style="{StaticResource Caps}" Margin="4,26,0,10"/>

        <Border Grid.Row="2" Style="{StaticResource Card}">
          <ItemsControl x:Name="HomeCards" ItemTemplate="{StaticResource AreaRowTemplate}" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="1"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </Border>

        <!-- The action panel. -->
        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
          <DockPanel Margin="20,14,20,0">
            <TextBlock x:Name="HomeCount" DockPanel.Dock="Top" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="54" FontWeight="Bold"
                       Foreground="{DynamicResource Text}" HorizontalAlignment="Center" Height="72" Margin="0,6,0,0"
                       RenderTransformOrigin="0.5,0.6"/>
            <TextBlock x:Name="HomeReady" DockPanel.Dock="Top" FontSize="13.5" Foreground="{DynamicResource Text2}" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>
            <Border DockPanel.Dock="Top" Style="{StaticResource Rule}" Margin="0,18,0,0"/>
            <ToggleButton x:Name="OptionalSwitch" DockPanel.Dock="Top" Style="{StaticResource Switch}" Margin="0,14,0,0"/>
            <TextBlock x:Name="HomeReadySub" DockPanel.Dock="Top" FontSize="11.5" Foreground="{DynamicResource Text4}" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="0,14,0,0"/>
            <Button x:Name="BtnHomeUndo" DockPanel.Dock="Bottom" Style="{StaticResource SecondaryButton}" ContentTemplate="{StaticResource ToolTemplate}"
                    HorizontalAlignment="Center" Margin="0,0,0,24"/>
            <!-- The button, with room around it for the light that breathes about it. While
                 there is nothing to do, a tick of the same size stands in its place. -->
            <Grid VerticalAlignment="Center" Margin="0,30,0,34">
              <Button x:Name="BtnDebloat" Style="{StaticResource GoButton}"/>
              <Viewbox x:Name="HomeMedal" Width="104" Height="104" Visibility="Collapsed">
                <ContentPresenter Content="" ContentTemplate="{StaticResource TickBadge}"/>
              </Viewbox>
            </Grid>
          </DockPanel>
        </Border>
      </Grid>

      <!-- One area: choose what is included -->
      <Grid x:Name="ViewList" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="34,10,34,0">
          <Button x:Name="BtnBack" DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Margin="0,0,18,0" VerticalAlignment="Center"/>
          <Viewbox DockPanel.Dock="Left" Width="56" Height="56" VerticalAlignment="Center">
            <ContentPresenter x:Name="ListOrb" ContentTemplate="{StaticResource IconTemplate}"/>
          </Viewbox>
          <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="ListTitle" Style="{StaticResource PageTitle}" FontSize="22"/>
            <TextBlock x:Name="ListIntro" Style="{StaticResource PageIntro}" FontSize="13"/>
          </StackPanel>
        </DockPanel>
        <DockPanel Grid.Row="1" Margin="34,18,34,0">
          <Button x:Name="BtnSelectNone" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"/>
          <Button x:Name="BtnSelectAll" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"/>
          <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Width="290" HorizontalAlignment="Left"/>
        </DockPanel>
        <ScrollViewer x:Name="ListScroll" Grid.Row="2" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Padding="34,0,24,10"
                      Margin="0,8,0,0" Focusable="False">
          <StackPanel>
            <ItemsControl x:Name="ListGroups" ItemTemplate="{StaticResource GroupTemplate}" Focusable="False"/>
            <StackPanel x:Name="ListEmpty" Visibility="Collapsed" Margin="0,40,0,20" HorizontalAlignment="Center">
              <Border x:Name="ListEmptyBadge" Width="52" Height="52" CornerRadius="26" Background="{DynamicResource SuccessBg}"
                      BorderBrush="{DynamicResource SuccessLine}" BorderThickness="1.5" HorizontalAlignment="Center">
                <TextBlock x:Name="ListEmptyGlyph" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="19" Foreground="{DynamicResource SuccessFg}"/>
              </Border>
              <TextBlock x:Name="ListEmptyTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
              <TextBlock x:Name="ListEmptyText" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center" TextAlignment="Center"
                         TextWrapping="Wrap" MaxWidth="420" Margin="0,4,0,0"/>
            </StackPanel>
            <TextBlock x:Name="DoneLabel" Style="{StaticResource Caps}" Margin="4,16,0,9" Visibility="Collapsed"/>
            <Border x:Name="DoneCard" Style="{StaticResource Card}" Visibility="Collapsed">
              <ItemsControl x:Name="DoneItems" ItemTemplate="{StaticResource DoneItemTemplate}" Focusable="False"/>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="3">
          <Border Style="{StaticResource Rule}"/>
          <DockPanel Margin="34,16,34,20">
            <Button x:Name="BtnDebloatSmall" DockPanel.Dock="Right" Style="{StaticResource PrimaryLargeButton}" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="BarTitle" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
              <TextBlock x:Name="BarSub" FontSize="12" Foreground="{DynamicResource Text3}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DockPanel>
        </Grid>
      </Grid>

      <!-- Debloating: a lane per area, the one being worked on brought forward. -->
      <Grid x:Name="ViewProgress" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="34,12,34,0">
          <TextBlock x:Name="ProgressEyebrow" Style="{StaticResource Caps}" Margin="2,0,0,0"/>
          <TextBlock x:Name="ProgressTitle" Style="{StaticResource PageTitle}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="ProgressCount" Style="{StaticResource PageIntro}"/>
          <ProgressBar x:Name="ProgressBar" Style="{StaticResource Meter}" Height="4" Margin="0,16,0,0"/>
          <TextBlock x:Name="ProgressNote" Foreground="{DynamicResource CautionFg}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
        </StackPanel>
        <Grid Grid.Row="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <!-- Tag holds the number of columns, so one or two lanes do not stretch across the window. -->
          <ItemsControl x:Name="ProgressLanes" ItemTemplate="{StaticResource LaneTemplate}" Margin="34,28,22,6"
                        Height="292" VerticalAlignment="Top" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1" Columns="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <!-- What has just been done, newest on top. It takes whatever height is left and
               is cut off there, so a small window simply shows fewer lines. -->
          <Border Grid.Row="1" ClipToBounds="True" Margin="38,12,34,0" MaxHeight="116" VerticalAlignment="Top">
            <ItemsControl x:Name="ProgressFeed" ItemTemplate="{StaticResource FeedTemplate}" Focusable="False" VerticalAlignment="Top">
              <ItemsControl.RenderTransform>
                <TranslateTransform Y="0"/>
              </ItemsControl.RenderTransform>
            </ItemsControl>
          </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="38,8,34,24" MinHeight="36">
          <StackPanel x:Name="ProgressButtons" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
            <Button x:Name="BtnProgressDetails" Style="{StaticResource SecondaryButton}"/>
            <Button x:Name="BtnProgressDone" Style="{StaticResource PrimaryButton}"/>
          </StackPanel>
          <TextBlock x:Name="ProgressIntro" Foreground="{DynamicResource Text4}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
      </Grid>

      <!-- Every step of a finished run -->
      <DockPanel x:Name="ViewResult" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top" Margin="34,12,34,6">
          <DockPanel>
            <Border x:Name="ResultBadge" DockPanel.Dock="Left" Width="52" Height="52" CornerRadius="26" Background="{DynamicResource SuccessBg}" VerticalAlignment="Top">
              <TextBlock x:Name="ResultGlyph" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="20" Foreground="{DynamicResource SuccessFg}"/>
            </Border>
            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="ResultTitle" Style="{StaticResource PageTitle}" FontSize="22"/>
              <TextBlock x:Name="ResultSummary" Style="{StaticResource PageIntro}" FontSize="13"/>
            </StackPanel>
          </DockPanel>
          <ItemsControl x:Name="ResultStats" ItemTemplate="{StaticResource StatTemplate}" Margin="0,20,-10,0" Focusable="False">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Rows="1"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <ItemsControl x:Name="ResultNotes" ItemTemplate="{StaticResource NoteTemplate}" Margin="0,12,0,0" Focusable="False"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="34,10,34,24">
          <Button x:Name="BtnOpenLog" Style="{StaticResource SecondaryButton}"/>
          <Button x:Name="BtnDone" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
        <ScrollViewer x:Name="ResultScroll" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Padding="34,6,24,6" Focusable="False">
          <Border Style="{StaticResource Card}" VerticalAlignment="Top">
            <ItemsControl x:Name="ResultSteps" ItemTemplate="{StaticResource StepTemplate}" Focusable="False"/>
          </Border>
        </ScrollViewer>
      </DockPanel>

      <!-- History -->
      <DockPanel x:Name="ViewHistory" Visibility="Collapsed">
        <DockPanel DockPanel.Dock="Top" Margin="34,10,34,6">
          <Button x:Name="BtnHistoryBack" DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Margin="0,0,18,0" VerticalAlignment="Center"/>
          <Viewbox DockPanel.Dock="Left" Width="56" Height="56" VerticalAlignment="Center">
            <ContentPresenter x:Name="HistoryOrb" ContentTemplate="{StaticResource IconTemplate}"/>
          </Viewbox>
          <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="HistoryTitle" Style="{StaticResource PageTitle}" FontSize="22"/>
            <TextBlock x:Name="HistoryIntro" Style="{StaticResource PageIntro}" FontSize="13"/>
          </StackPanel>
        </DockPanel>
        <ScrollViewer x:Name="HistoryScroll" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Padding="34,18,24,14" Focusable="False">
          <StackPanel>
            <ItemsControl x:Name="HistoryRuns" ItemTemplate="{StaticResource RunTemplate}" Focusable="False"/>
            <StackPanel x:Name="HistoryEmpty" Visibility="Collapsed" Margin="0,46,0,26" HorizontalAlignment="Center">
              <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource ChipFill}" BorderBrush="{DynamicResource RuleFill}" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" FontSize="19" Foreground="{DynamicResource Text2}"/>
              </Border>
              <TextBlock x:Name="HistoryEmptyTitle" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
              <TextBlock x:Name="HistoryEmptyText" Foreground="{DynamicResource Text2}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>

      <!-- Settings -->
      <ScrollViewer x:Name="ViewSettings" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed" Focusable="False">
        <StackPanel Margin="34,10,34,24">
          <DockPanel>
            <Button x:Name="BtnSettingsBack" DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Margin="0,0,18,0" VerticalAlignment="Center"/>
            <Viewbox DockPanel.Dock="Left" Width="56" Height="56" VerticalAlignment="Center">
              <ContentPresenter x:Name="SettingsOrb" ContentTemplate="{StaticResource IconTemplate}"/>
            </Viewbox>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="SettingsTitle" Style="{StaticResource PageTitle}" FontSize="22"/>
              <TextBlock x:Name="SettingsIntro" Style="{StaticResource PageIntro}" FontSize="13"/>
            </StackPanel>
          </DockPanel>
          <!-- Two columns: what you can change on the left, about the app on the right. -->
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="520"/>
              <ColumnDefinition Width="24"/>
              <ColumnDefinition Width="*" MaxWidth="460"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="SettingsLangLabel" Style="{StaticResource Caps}" Margin="4,18,0,9"/>
              <Border Style="{StaticResource Card}">
                <ItemsControl x:Name="LangChoices" ItemTemplate="{StaticResource ChoiceTemplate}" Focusable="False"/>
              </Border>
              <TextBlock x:Name="SettingsThemeLabel" Style="{StaticResource Caps}" Margin="4,20,0,9"/>
              <Border Style="{StaticResource Card}">
                <ItemsControl x:Name="ThemeChoices" ItemTemplate="{StaticResource ChoiceTemplate}" Focusable="False"/>
              </Border>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock x:Name="SettingsAboutLabel" Style="{StaticResource Caps}" Margin="4,18,0,9"/>
              <Border Style="{StaticResource Card}" Padding="18,16,18,12">
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource Brand}" VerticalAlignment="Center">
                      <ContentPresenter Content="" ContentTemplate="{StaticResource MarkTemplate}" Margin="8"/>
                    </Border>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                      <TextBlock x:Name="AboutName" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                      <TextBlock x:Name="AboutVersion" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="{DynamicResource Text3}" Margin="0,2,0,0"/>
                      <TextBlock x:Name="AboutCopyright" FontSize="11.5" Foreground="{DynamicResource Text3}" Margin="0,2,0,0"/>
                    </StackPanel>
                  </StackPanel>
                  <TextBlock x:Name="AboutPrivacy" FontSize="12" Foreground="{DynamicResource Text2}" TextWrapping="Wrap" Margin="0,14,0,10"/>
                  <ToggleButton x:Name="UpdateSwitch" Style="{StaticResource Switch}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="LinkUpdate" Style="{StaticResource LinkButton}"/>
                    <TextBlock x:Name="UpdateStatus" FontSize="12" Foreground="{DynamicResource Text3}" VerticalAlignment="Center" Margin="6,0,0,1"/>
                  </StackPanel>
                  <Border Style="{StaticResource Rule}" Margin="0,8,0,8"/>
                  <Button x:Name="LinkRepo" Style="{StaticResource LinkButton}"/>
                  <Button x:Name="LinkChanges" Style="{StaticResource LinkButton}"/>
                  <Button x:Name="LinkData" Style="{StaticResource LinkButton}"/>
                  <Button x:Name="LinkLicence" Style="{StaticResource LinkButton}"/>
                  <Button x:Name="LinkSite" Style="{StaticResource LinkButton}"/>
                  <Button x:Name="LinkSupport" Style="{StaticResource LinkButton}"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </StackPanel>
      </ScrollViewer>

    </Grid>

    <!-- Confirmation sheet, shown over whatever page is open, top bar included -->
    <Grid x:Name="ConfirmOverlay" Visibility="Collapsed" Background="{DynamicResource Dim}" Panel.ZIndex="10">
      <Border x:Name="ConfirmSheet" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="16" Padding="24,22,24,20"
              Background="{DynamicResource Sheet}" BorderBrush="{DynamicResource Edge}" BorderThickness="1"
              RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
          <TransformGroup>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
            <TranslateTransform Y="0"/>
          </TransformGroup>
        </Border.RenderTransform>
        <Border.Effect>
          <DropShadowEffect BlurRadius="40" ShadowDepth="14" Direction="270" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
          <TextBlock x:Name="ConfirmEyebrow" Style="{StaticResource Caps}" Margin="0,0,0,8" Visibility="Collapsed"/>
          <TextBlock x:Name="ConfirmTitle" Style="{StaticResource PageTitle}" FontSize="20"/>
          <TextBlock x:Name="ConfirmSub" Style="{StaticResource PageIntro}" FontSize="13" Margin="0,4,0,14"/>
          <Border x:Name="ConfirmCard" Style="{StaticResource Card}">
            <ItemsControl x:Name="ConfirmRows" ItemTemplate="{StaticResource SummaryTemplate}" Focusable="False"/>
          </Border>
          <!-- How far a download is. -->
          <ProgressBar x:Name="ConfirmMeter" Style="{StaticResource Meter}" Height="4" Margin="0,4,0,2" Visibility="Collapsed"/>
          <TextBlock x:Name="ConfirmFine" FontSize="12" Foreground="{DynamicResource Text3}" TextWrapping="Wrap" Margin="2,12,2,18" LineHeight="18"/>
          <StackPanel x:Name="ConfirmButtons" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnConfirmCancel" Style="{StaticResource GhostButton}"/>
            <Button x:Name="BtnConfirmMore" Style="{StaticResource GhostButton}" Visibility="Collapsed"/>
            <Button x:Name="BtnConfirmGo" Style="{StaticResource PrimaryButton}"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
